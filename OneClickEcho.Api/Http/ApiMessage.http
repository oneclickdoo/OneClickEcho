@OneClickEcho_HostAddress = http://localhost:5050
@OneClickEcho_HostAddress_Prod = https://viber.oneclick.rs

### Send message dev
POST {{OneClickEcho_HostAddress}}/api/message/send
Content-Type: application/json

{
  "companyId": "b25cfadc-8a0f-4306-be83-821116ca6e2e",
  "apiPassword": "TestPassword",
  "apiMessageType": 1,
  "sender": "OneClickTest",
  
  "phoneNumber": "+381621671771",
  "message": "Test message.",
  "viberMedia": "https://www.worldanimalprotection.ca/cdn-cgi/image/width=800,format=auto,fit=cover/siteassets/article/hero3_1032346_final.jpg",
  "viberButtonUrl": "https://echo.oneclick.rs",
  "viberButtonUrlTitle": "Test button"
}

### Get message status
GET {{OneClickEcho_HostAddress}}/api/message/{{messageId}}/status?companyId=b25cfadc-8a0f-4306-be83-821116ca6e2e&apiPassword=TestPassword
Accept: application/json

### Send carousel
POST {{OneClickEcho_HostAddress}}/api/message/send
Content-Type: application/json

{
  "companyId": "b25cfadc-8a0f-4306-be83-821116ca6e2e",
  "apiPassword": "TestPassword",
  "apiMessageType": 1,
  "sender": "OneClickTest",
  "phoneNumber": "+381621671771",
  "message": "Carousel intro",
  "viberCarouselJson": "{\"items\":[{\"imageUrl\":\"https://example.com/a.jpg\",\"title\":\"Card one\",\"primaryButton\":{\"label\":\"Open\",\"actionUrl\":\"https://example.com\"}},{\"imageUrl\":\"https://example.com/b.jpg\",\"title\":\"Card two\",\"primaryButton\":{\"label\":\"Open\",\"actionUrl\":\"https://example.com\"}}]}"
}

### Create transactional template
POST {{OneClickEcho_HostAddress}}/api/viber/templates
Content-Type: application/json

{
  "companyId": "b25cfadc-8a0f-4306-be83-821116ca6e2e",
  "apiPassword": "TestPassword",
  "display": "OneClickTest",
  "name": "Code ready",
  "language": "en",
  "body": "Hello {{name}}, your code is ready."
}

### Session reply (inside the 24h window)
POST {{OneClickEcho_HostAddress}}/api/viber/session/send
Content-Type: application/json

{
  "companyId": "b25cfadc-8a0f-4306-be83-821116ca6e2e",
  "apiPassword": "TestPassword",
  "sender": "OneClickTest",
  "phoneNumber": "+381621671771",
  "kind": 0,
  "text": "Thanks for your reply.",
  "allowOutsideSession": false
}

### Send message prod
POST {{OneClickEcho_HostAddress_Prod}}/api/message/send
Content-Type: application/json

{
  "companyId": "01dec13d-be5f-42fb-876e-a5311a255e65",
  "apiPassword": "TestPassword",
  "apiMessageType": 2,
  "sender": "KOMENTAR",

  "phoneNumber": "+38163218347",
  "message": "Test message."
}
